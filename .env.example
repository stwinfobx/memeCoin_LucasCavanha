# ======================================================
# CONFIGURACOES GERAIS DO SISTEMA
# ======================================================

NODE_ENV=development
PORT=4000
APP_NAME=TradingBotAI
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ======================================================
# BANCO DE DADOS (Supabase)
# ======================================================
# Obter em: https://supabase.com/dashboard > Seu Projeto > Settings > Database
# Copiar "Connection String" e preencher abaixo

DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
POSTGRES_HOST=db.SEU_PROJETO.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUA_SENHA_SUPABASE
POSTGRES_SSL=true

# ======================================================
# SEGURANCA / AUTENTICACAO
# ======================================================
# IMPORTANTE: Gerar chaves unicas! Ver docs/GUIA_CONFIGURACAO_DEPLOY.md

JWT_SECRET=GERAR_CHAVE_UNICA_BASE64
JWT_EXPIRATION=1800min
REFRESH_TOKEN_EXPIRATION=7d
ENCRYPTION_KEY=GERAR_CHAVE_64_CARACTERES_HEX
CORS_ORIGIN=http://localhost:3000

# ======================================================
# EMAIL / NOTIFICACOES (Resend)
# ======================================================
# Obter em: https://resend.com/api-keys

EMAIL_SERVICE=resend
RESEND_API_KEY=re_SUA_CHAVE_RESEND_AQUI
EMAIL_FROM=noreply@seudominio.com
EMAIL_ALERTS_ENABLED=false

# ======================================================
# MICROSERVICES URLS
# ======================================================

SIGNAL_SERVICE_URL=http://localhost:4002
SIGNAL_REQUEST_TIMEOUT_MS=5000
EXECUTOR_SERVICE_URL=http://localhost:4003
EXECUTOR_REQUEST_TIMEOUT_MS=5000
EXECUTOR_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ======================================================
# APIs DE MERCADO / DEX
# ======================================================

GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_NETWORK=bsc
GECKOTERMINAL_PAGE=1
DEX_API_URL=https://api.dexscreener.com/latest/dex
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# BSCScan API Key
# Obter em: https://bscscan.com/apis
BSCSCAN_API_KEY=SUA_CHAVE_BSCSCAN

# ======================================================
# BLOCKCHAIN / BSC
# ======================================================

# RPC URL para BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Wallet do Bot (CRITICA!)
# 1. Criar nova wallet no MetaMask
# 2. Exportar private key
# 3. Encriptar usando script em docs/GUIA_CONFIGURACAO_DEPLOY.md
# 4. Colar resultado abaixo
BOT_WALLET_PRIVATE_KEY={"encrypted":"...","iv":"...","authTag":"..."}

# Endereco publico da wallet (para receber depositos)
BOT_DEPOSIT_ADDRESS=0xSEU_ENDERECO_WALLET_BSC
NEXT_PUBLIC_BOT_DEPOSIT_ADDRESS=0xSEU_ENDERECO_WALLET_BSC

# PancakeSwap / DEX Addresses
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
BNB_PRICE=600

# ======================================================
# SOLANA (Opcional - para futuro)
# ======================================================

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLSCAN_API_KEY=SUA_CHAVE_SOLSCAN_OPCIONAL

# ======================================================
# CONFIGURACOES DO BOT
# ======================================================

# IMPORTANTE: Usar 'live' para trading real, 'simulation' para testes
BOT_EXECUTION_MODE=live

BOT_REFRESH_INTERVAL=5
BOT_RISK_LEVEL=medium
BOT_MAX_OPEN_TRADES=3
BOT_MAX_LOSS_PERCENT=10
BOT_MAX_GAIN_PERCENT=25

# ======================================================
# SINAIS / ESTRATEGIAS
# ======================================================

SIGNAL_CONFIDENCE_THRESHOLD=2
SIGNAL_OVERALL_THRESHOLD=2.5
SIGNAL_PRICE_THRESHOLD=0.02
PRICE_COLLECTION_MINUTES=1
AUTO_ANALYZE_INTERVAL_MINUTES=5

# ======================================================
# INTELIGENCIA ARTIFICIAL (Opcional)
# ======================================================

AI_SERVICE_URL=http://ia:5000
AI_CONFIDENCE_THRESHOLD=0.8
AI_SCAN_INTERVAL=60

# ======================================================
# LOGS / DOCKER
# ======================================================

LOG_LEVEL=info
DOCKER_NETWORK=tradingbot_network
