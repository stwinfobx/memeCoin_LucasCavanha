generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_DIRECT_URL")
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
  extensions        = [uuid_ossp(), pgcrypto()]
}

model User {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  mfaEnabled   Boolean       @map("mfa_enabled") @default(false)
  mfaSecret    String?       @map("mfa_secret") @db.VarChar(255)
  isActive     Boolean       @map("is_active") @default(true)
  createdAt    DateTime?     @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?     @map("updated_at") @default(now()) @db.Timestamp(6)

  profile      UserProfile?
  orders       Order[]
  ledger       LedgerEntry[]
  audits       AuditLog[]

  @@map("users")
}

model UserProfile {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  fullName        String?  @map("full_name") @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  bankAccount     String?  @map("bank_account_number") @db.VarChar(100)
  bankName        String?  @map("bank_name") @db.VarChar(100)
  bankRouting     String?  @map("bank_routing_number") @db.VarChar(100)
  walletAddress   String?  @map("wallet_address") @db.VarChar(255)
  riskProfile     Risk     @map("risk_profile") @default(moderate)
  botEnabled      Boolean  @map("bot_enabled") @default(false)
  botIntensity    Int      @map("bot_intensity") @default(5)
  kycStatus       Kyc      @map("kyc_status") @default(pending)
  maxLossPercent  Decimal  @map("max_loss_percent") @default(10.0) @db.Decimal(5, 2)
  maxGainPercent  Decimal  @map("max_gain_percent") @default(25.0) @db.Decimal(5, 2)
  maxOpenTrades   Int      @map("max_open_trades") @default(3)
  createdAt       DateTime? @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt       DateTime? @map("updated_at") @default(now()) @db.Timestamp(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Token {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  contract       String    @map("contract_address") @db.VarChar(255)
  chain          String    @db.VarChar(50)
  symbol         String    @db.VarChar(50)
  name           String    @db.VarChar(255)
  decimals       Int       @default(18)
  totalSupply    Decimal?  @map("total_supply") @db.Decimal(78, 0)
  liquidityUsd   Decimal?  @map("liquidity_usd") @db.Decimal(20, 2)
  liquidityLocked Boolean  @map("liquidity_locked") @default(false)
  holdersCount   Int       @map("holders_count") @default(0)
  volume24hUsd   Decimal?  @map("volume_24h_usd") @db.Decimal(20, 2)
  priceUsd       Decimal?  @map("price_usd") @db.Decimal(20, 10)
  safetyScore    Int?      @map("safety_score")
  isHoneypot     Boolean   @map("is_honeypot") @default(false)
  isValidated    Boolean   @map("is_validated") @default(false)
  validatedAt    DateTime? @map("validated_at") @db.Timestamp(6)
  firstSeenAt    DateTime? @map("first_seen_at") @default(now()) @db.Timestamp(6)
  createdAt      DateTime? @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime? @map("updated_at") @default(now()) @db.Timestamp(6)

  signals        Signal[]
  orders         Order[]

  @@map("tokens")
}

model Signal {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tokenId            String    @map("token_id") @db.Uuid
  type               SignalType @map("signal_type")
  confidenceScore    Decimal?  @map("confidence_score") @db.Decimal(5, 2)
  potentialMultiplier Decimal? @map("potential_multiplier") @db.Decimal(4, 2)
  volumeScore        Decimal?  @map("volume_score") @db.Decimal(5, 2)
  liquidityScore     Decimal?  @map("liquidity_score") @db.Decimal(5, 2)
  holdersScore       Decimal?  @map("holders_score") @db.Decimal(5, 2)
  ageScore           Decimal?  @map("age_score") @db.Decimal(5, 2)
  safetyScore        Decimal?  @map("safety_score") @db.Decimal(5, 2)
  overallScore       Decimal?  @map("overall_score") @db.Decimal(5, 2)
  priceAtSignal      Decimal?  @map("price_at_signal") @db.Decimal(20, 10)
  reasoning          String?   @db.Text
  isActive           Boolean   @map("is_active") @default(true)
  expiresAt          DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt          DateTime? @map("created_at") @default(now()) @db.Timestamp(6)

  token              Token     @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@map("signals")
}

model Order {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenId       String    @map("token_id") @db.Uuid
  signalId      String?   @map("signal_id") @db.Uuid
  type          OrderType @map("order_type")
  status        OrderStatus @default(pending)
  amountUsd     Decimal    @map("amount_usd") @db.Decimal(20, 2)
  amountToken   Decimal?   @map("amount_token") @db.Decimal(40, 18)
  priceUsd      Decimal?   @map("price_usd") @db.Decimal(20, 10)
  transactionHash String?  @map("transaction_hash") @db.VarChar(255)
  gasUsed       Decimal?   @map("gas_used") @db.Decimal(20, 0)
  gasPrice      Decimal?   @map("gas_price") @db.Decimal(20, 0)
  blockNumber   Decimal?   @map("block_number") @db.Decimal(20, 0)
  executedAt    DateTime?  @map("executed_at") @db.Timestamp(6)
  createdAt     DateTime?  @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt     DateTime?  @map("updated_at") @default(now()) @db.Timestamp(6)

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         Token      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  signal        Signal?    @relation(fields: [signalId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@map("orders")
}

model LedgerEntry {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  orderId       String?   @map("order_id") @db.Uuid
  entryType     LedgerType @map("entry_type")
  amountUsd     Decimal    @map("amount_usd") @db.Decimal(20, 2)
  balanceBefore Decimal?   @map("balance_before") @db.Decimal(20, 2)
  balanceAfter  Decimal?   @map("balance_after") @db.Decimal(20, 2)
  description   String?    @db.Text
  createdAt     DateTime?  @map("created_at") @default(now()) @db.Timestamp(6)

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("ledger_entries")
}

model AuditLog {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String    @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(50)
  resourceId  String?   @map("resource_id") @db.Uuid
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent")
  requestData Json?     @map("request_data")
  responseData Json?    @map("response_data")
  statusCode  Int?      @map("status_code")
  errorMessage String?  @map("error_message")
  createdAt   DateTime? @map("created_at") @default(now()) @db.Timestamp(6)

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

enum Risk {
  conservative
  moderate
  aggressive
}

enum Kyc {
  pending
  approved
  rejected
}

enum SignalType {
  BUY
  SELL
  HOLD
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  pending
  executing
  completed
  failed
  cancelled
}

enum LedgerType {
  deposit
  withdrawal
  trade_profit
  trade_loss
  fee
  gas
}
