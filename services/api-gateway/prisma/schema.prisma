  users_withdrawals_user_idTousers     User      @relation("withdrawals_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_withdrawals_created")
  @@index([status], map: "idx_withdrawals_status")
  @@index([user_id], map: "idx_withdrawals_user_id")
}
