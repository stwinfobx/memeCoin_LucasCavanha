  timestamp   DateTime  @db.Timestamp(6)
  open_price  Decimal   @db.Decimal(20, 10)
  high_price  Decimal   @db.Decimal(20, 10)
  low_price   Decimal   @db.Decimal(20, 10)
  close_price Decimal   @db.Decimal(20, 10)
  volume_usd  Decimal   @db.Decimal(20, 2)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  tokens      Token     @relation(fields: [token_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([token_id, interval, timestamp])
  @@index([timestamp(sort: Desc)], map: "idx_candles_timestamp")
  @@index([token_id, interval], map: "idx_candles_token_interval")
  @@index([token_id, interval, timestamp(sort: Desc)], map: "idx_candles_token_interval_time")
}

model token_risk_assessments {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token_id         String    @unique(map: "idx_token_risk_assessments_token_id") @db.Uuid
  contract_address String    @db.VarChar(255)
  chain            String    @db.VarChar(50)
  memecoin_score   Decimal   @db.Decimal(5, 2)
  risk_score       Decimal   @db.Decimal(5, 2)
  scam_probability Decimal   @db.Decimal(5, 2)
  risk_level       String    @db.VarChar(32)
  indicators       Json
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  tokens           Token     @relation(fields: [token_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([contract_address, chain], map: "idx_token_risk_assessments_contract_chain")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_wallets {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id               String    @db.Uuid
  encrypted_private_key String
  wallet_address        String    @db.VarChar(255)
  chain                 String    @default("BSC") @db.VarChar(50)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  users                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, chain])
  @@index([wallet_address], map: "idx_wallets_address")
  @@index([user_id], map: "idx_wallets_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model withdrawals {
  id                                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                              String    @db.Uuid
  amount_usd                           Decimal   @db.Decimal(20, 2)
  wallet_address                       String    @db.VarChar(255)
  chain                                String    @default("BSC") @db.VarChar(50)
  status                               String?   @default("pending") @db.VarChar(20)
  tx_hash                              String?   @db.VarChar(255)
  approved_by                          String?   @db.Uuid
  approved_at                          DateTime? @db.Timestamp(6)
  processed_at                         DateTime? @db.Timestamp(6)
