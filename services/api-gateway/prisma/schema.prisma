  signal_id           String?   @db.Uuid
  invested_amount_usd Decimal   @db.Decimal(20, 2)
  buy_price_usd       Decimal   @db.Decimal(20, 10)
  buy_time            DateTime  @db.Timestamp(6)
  current_price_usd   Decimal?  @db.Decimal(20, 10)
  token_balance       Decimal   @db.Decimal(40, 18)
  hold_time_hours     Decimal?  @default(0) @db.Decimal(10, 2)
  status              String?   @default("open") @db.VarChar(20)
  closed_at           DateTime? @db.Timestamp(6)
  profit_loss_usd     Decimal?  @db.Decimal(20, 2)
  profit_loss_percent Decimal?  @db.Decimal(8, 4)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  orders              Order?    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signals             Signal?   @relation(fields: [signal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tokens              Token     @relation(fields: [token_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_positions_created")
  @@index([status], map: "idx_positions_status")
  @@index([token_id], map: "idx_positions_token_id")
  @@index([user_id], map: "idx_positions_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
